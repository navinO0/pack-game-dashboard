# Local development (dedicated SQLite database)
DATABASE_URL="file:./pack_score_calc.db"

# Production / Shared PostgreSQL (ALWAYS include ?schema=pack_score_calc to isolate from other apps)
# DATABASE_URL="postgresql://user:password@host:5432/shared_db?schema=pack_score_calc"

# Dedicated PostgreSQL schema name (used by scripts/db-migrate-prod.sh)
DB_SCHEMA_NAME="pack_score_calc"

# JWT signing secret (generate with: openssl rand -base64 48)
AUTH_SECRET="change-this-to-a-strong-64-character-random-secret-in-production"

# Session duration in days
SESSION_MAX_AGE_DAYS=7

# Application metadata
NEXT_PUBLIC_APP_NAME="PackScore Pro"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_CURRENCY_CODE="INR"

# Logging level: debug | info | warn | error
LOG_LEVEL="info"

# Node environment
NODE_ENV="development"
